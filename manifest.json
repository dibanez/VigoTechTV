{
   "name": "VigoTechTV",
   "short_name": "VigoTechTV",
   "author": "David Ibañez",
   "version": "3.0",
   "manifest_version": 3,
   "minimum_chrome_version": "116",
   "description": "Record meetups with screen, camera and microphone",
   "background": {
      "service_worker": "background/service-worker.js"
   },
   "commands": {
      "stop-recording": {
         "suggested_key": { "default": "Ctrl+Shift+S" },
         "description": "Detener la grabación"
      }
   },
   "action": {
      "default_icon": "images/main-icon.png",
      "default_title": "Record Your Screen, Tab or Camera",
      "default_popup": "dropdown.html"
   },
   "icons": {
      "16": "images/main-icon.png",
      "22": "images/main-icon.png",
      "32": "images/main-icon.png",
      "48": "images/main-icon.png",
      "128": "images/main-icon.png"
   },
   "permissions": [
      "desktopCapture",
      "storage",
      "tabs",
      "tabCapture",
      "activeTab",
      "identity",
      "offscreen",
      "scripting"
   ],
   "host_permissions": [
      "https://www.googleapis.com/*"
   ],
   "oauth2": {
       "client_id": "393001847715-2p3sqvaqu4067jqs5sj5u8shs0kg7hm3.apps.googleusercontent.com",
       "scopes": [
         "https://www.googleapis.com/auth/youtube.upload",
         "https://www.googleapis.com/auth/youtube",
         "https://www.googleapis.com/auth/youtube.force-ssl"
       ]
   },
   "options_ui": {
      "page": "options.html",
      "open_in_tab": true
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' data: blob: https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn.jsdelivr.net https://api.openai.com"
   }
}
